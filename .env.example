# Shopify Storefront API (Shopify admin → Sales channels → Headless → your storefront → Storefront API)
# Copy to .env.local for local dev (.env.local is git-ignored). Add the same three on Vercel.

# Use the myshopify domain for API calls (the custom domain also works)
SHOPIFY_STORE_DOMAIN=twistedrealityent.myshopify.com

# PUBLIC Storefront access token (not the private token, never an Admin API token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version. Default matches @shopify/hydrogen-react 2026.4.x.
SHOPIFY_STOREFRONT_API_VERSION=2026-04
