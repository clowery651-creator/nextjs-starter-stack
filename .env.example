# Copy to .env.local for local dev (.env.local is git-ignored). Add the same values on Vercel.
# Never commit real tokens or secrets.

# --- Shopify Storefront API ---
# Shopify admin → Sales channels → Headless → your storefront → Storefront API
# Use the myshopify domain for API calls (the custom domain also works)
SHOPIFY_STORE_DOMAIN=twistedrealityent.myshopify.com

# PUBLIC Storefront access token (not the private token, never an Admin API token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version. Default matches @shopify/hydrogen-react 2026.4.x.
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# --- Site ---
# Canonical origin used for metadata, canonical URLs, OG tags, sitemap and robots,
# and for the Customer Account API redirect URI (<NEXT_PUBLIC_SITE_URL>/account/authorize).
# If unset, falls back to VERCEL_PROJECT_PRODUCTION_URL (set automatically on Vercel), then localhost.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Customer accounts (Customer Account API, OAuth 2.0 + PKCE) ---
# Leave the client id empty to use Shopify-hosted accounts (account.twistedrealityentertainment.com).
# Shopify admin → Sales channels → Headless → Next.js Starter Stack → Customer Account API → Credentials.
# Client type: Public. Register https://<site>/account/authorize (callback), https://<site> (JS origin + logout).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Required with the client id. At least 32 chars: openssl rand -base64 48
SESSION_SECRET=
# Optional. Endpoints are discovered from SHOPIFY_STORE_DOMAIN/.well-known/*; the shop id is only a fallback.
SHOPIFY_SHOP_ID=
# Optional: only for a Confidential client type.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Optional overrides (normally discovered):
# SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2026-10
# SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZE_URL=
# SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
# SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URL=
# SHOPIFY_CUSTOMER_ACCOUNT_GRAPHQL_URL=

# --- On-demand revalidation ---
# Shopify webhook signing secret (Settings → Notifications → Webhooks, shown at the bottom
# of the page), used to verify X-Shopify-Hmac-Sha256 on POST /api/revalidate.
# Also accepted as ?secret= or an x-revalidation-secret header for manual calls.
SHOPIFY_REVALIDATION_SECRET=
